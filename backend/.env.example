# NeuralCafe Backend - Environment Variables
# Copy this file to .env and fill in your values
# Get Supabase credentials from: https://supabase.com/dashboard → Settings → API
# Get Groq key from: https://console.groq.com
# Get Gemini key from: https://aistudio.google.com/app/apikey

SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
PORT=3001
